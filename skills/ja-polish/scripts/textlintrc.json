{
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": { "max": 80 },
      "max-ten": { "max": 3 },
      "max-kanji-continuous-len": { "max": 6 },
      "no-mix-dearu-desumasu": { "preferInHeader": "", "preferInBody": "", "preferInList": "", "strict": false },
      "no-doubled-joshi": { "min_interval": 1, "strict": false },
      "no-exclamation-question-mark": false,
      "ja-no-weak-phrase": true,
      "ja-no-redundant-expression": true
    },
    "preset-ja-spacing": {
      "ja-space-between-half-and-full-width": false,
      "ja-space-around-code": false
    },
    "@textlint-ja/preset-ai-writing": true,
    "prh": { "rulePaths": ["./prh-hiraku.yml"] }
  }
}
